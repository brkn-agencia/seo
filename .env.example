# Base de datos (Neon)
DATABASE_URL=postgresql://user:password@host/dbname

# Encriptación de API keys (generá uno random de 32 chars)
ENCRYPTION_KEY=tu-clave-de-32-caracteres-aqui!!

# Tienda Nube OAuth
TN_CLIENT_ID=tu-client-id
TN_CLIENT_SECRET=tu-client-secret

# Login del admin (agencia). El admin se crea al arrancar si no existe.
ADMIN_EMAIL=admin@bruda.io
ADMIN_PASSWORD=una-contraseña-fuerte
# Firma de tokens de sesión (si está vacío usa ENCRYPTION_KEY).
JWT_SECRET=otra-clave-secreta
# (legacy) si no hay ADMIN_PASSWORD, se usa esta como contraseña del admin.
AGENCY_PASSWORD=una-contraseña-fuerte
